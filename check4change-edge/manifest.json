{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Check4Change",
  "version": "3.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/c4c-16.png",
    "32": "icons/c4c-32.png",
    "48": "icons/c4c-48.png",
    "128": "icons/c4c-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/c4c-16.png",
      "32": "icons/c4c-32.png"
    },
    "default_title": "Check4Change"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "tabs",
    "contextMenus",
    "notifications",
    "storage",
    "alarms",
    "scripting",
    "webNavigation",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "pages/overlay.html",
        "pages/tutorial.html",
        "pages/settingsDialog.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
